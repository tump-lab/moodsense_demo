rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// Sensing and log events are keyed by device id, not auth uid, so access is checked against each doc's `uid` field instead of the path.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /sensing/{deviceId}/events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid;
    }

    match /logs/{deviceId}/events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid;
    }

    // A collectionGroup() query is only allowed by a `{path=**}` rule, so this is needed even though the rules above allow the same reads.
    // It is read-only so it can't be used to create `events` collections elsewhere.
    match /{path=**}/events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    match /community_agg/{geohash} {
      allow read: if request.auth != null;
      allow write: if false; // written server-side only
    }

    // Peer-group chat rooms. Only members read a room's messages and member list; the AI guide's
    // messages (kind 'guide') are never written by a client — the Worker writes them (worker/src/groupGuide.ts).
    // `ai` mirrors the member's "Use AI" setting; the Worker only sends AI-on members' messages to the model.
    match /group_rooms/{groupId} {
      function isMember() {
        return request.auth != null
          && exists(/databases/$(database)/documents/group_rooms/$(groupId)/members/$(request.auth.uid));
      }

      function myMember() {
        return /databases/$(database)/documents/group_rooms/$(groupId)/members/$(request.auth.uid);
      }

      allow read: if request.auth != null;
      // The first member to join names the room for the guide; nobody can rename it afterwards.
      // It is created in the same batch as its first member doc, with memberCount 1.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'about', 'memberCount'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.about is string && request.resource.data.about.size() <= 300
        && request.resource.data.memberCount == 1
        && !exists(myMember()) && existsAfter(myMember());
      // Only memberCount changes, by exactly one, and only in the same batch that adds or removes the
      // caller's own member doc — so the count shown on group cards cannot be inflated or drained.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && (
          (request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1
            && !exists(myMember()) && existsAfter(myMember()))
          || (request.resource.data.memberCount == resource.data.get('memberCount', 0) - 1
            && exists(myMember()) && !existsAfter(myMember()))
        );

      match /members/{uid} {
        allow read: if isMember();
        function validMember() {
          return request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['uid', 'name', 'ai', 'joinedAt'])
            && request.resource.data.uid == uid
            && request.resource.data.ai is bool
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.joinedAt == request.time;
        }
        function roomPath() {
          return /databases/$(database)/documents/group_rooms/$(groupId);
        }
        // Joining and leaving move the room's memberCount in the same batch (see the room rules above).
        allow create: if validMember()
          && (
            (!exists(roomPath()) && getAfter(roomPath()).data.memberCount == 1)
            || (exists(roomPath())
              && getAfter(roomPath()).data.get('memberCount', 0) == get(roomPath()).data.get('memberCount', 0) + 1)
          );
        allow update: if validMember();
        allow delete: if request.auth != null && request.auth.uid == uid
          && getAfter(roomPath()).data.get('memberCount', 0) == get(roomPath()).data.get('memberCount', 0) - 1;
      }

      match /messages/{messageId} {
        allow read: if isMember();
        // A message carries the sender's own uid and their pseudonym from the member list, so nobody can post as someone else.
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'kind', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == get(/databases/$(database)/documents/group_rooms/$(groupId)/members/$(request.auth.uid)).data.name
          && request.resource.data.kind == 'member'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.ts == request.time;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
