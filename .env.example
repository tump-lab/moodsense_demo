# Copy to .env; every value is optional and the app runs offline with mocks when they are empty.
# The Claude API key is not set here: it is a secret on the Cloudflare Worker in worker/ (see the end of this file).
# Model names are not secrets, so they stay client-side; the server checks them against an allowlist.
EXPO_PUBLIC_ANTHROPIC_MODEL=

# Set to 'false' for a build that never calls any AI provider; anything else means on.
# Each account still starts with AI off until the person turns it on in Settings.
EXPO_PUBLIC_AI_ENABLED=…

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Leave empty to hide the "Continue with Google" button.
# The iOS client ID must also be added, reversed, as the plugin's `iosUrlScheme` in app.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Address of the Cloudflare Worker in worker/ (the Claude proxy, hourly community counts, data deletion).
# Printed by `npx wrangler deploy`, e.g. https://moodsense-api.<your-subdomain>.workers.dev
# Not a secret. The Claude key itself lives only on the Worker:
#
#   cd worker && npx wrangler secret put ANTHROPIC_API_KEY
EXPO_PUBLIC_API_URL=
